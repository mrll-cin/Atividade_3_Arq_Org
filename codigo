.data
    vetor: .space 16             # Reserva 16 bytes na memoria (espaco para 4 inteiros de 4 bytes)
    msg_prompt: .asciiz " "
    msg_out: .asciiz "Soma total: "

.text
.globl main
main:
    # Carrega o endereco base do vetor no registrador $s0
    la $s0, vetor
    # ---------------------------------------------------------
    # LACO 1: LEITURA DOS PARES E PREENCHIMENTO DO VETOR
    # ---------------------------------------------------------
    li $t0, 0                    # $t0 = i (Contador do laco 1, comeca em 0)
    la $t2, vetor                # endereco base em $t2

Loop_Leitura:
    beq $t0, 4, Fim_Leitura      # Se i == 4, sai do laco

    # [ESCREVA AQUI: Ler o n1 usando syscall 5]
    li $v0, 5          # Le inteiro
    syscall
    move $t3, $v0      # Guarda em $t3

    # [ESCREVA AQUI: Ler o n2 usando syscall 5]
    li $v0, 5         
    syscall
    move $t4, $v0     

    # [ESCREVA AQUI: Somar o n1 e o n2]
    add $t5, $t3, $t4

    # [ESCREVA AQUI: Calcular o offset na memoria multiplicando 'i' por 4 (use sll)]
    sll $t2, $t0, 2            
    
    # [ESCREVA AQUI: Somar offset ao endereco base ($s0) e salvar a soma no vetor (sw)]
    add $t3, $s0, $t2        
    sw  $t5, 0($t3)    

    addi $t0, $t0, 1             # Incrementa o contador (i++)
    j Loop_Leitura               # Volta para o inicio do laco

Fim_Leitura:
    # ---------------------------------------------------------
    # LACO 2: VARREDURA DO VETOR PARA SOMA TOTAL
    # ---------------------------------------------------------
    li $t0, 0         # Reseta o contador para o segundo laco (t0 = i = 0)
    la $t2, vetor     # Reseta o ponteiro para o inicio do vetor
    li $s1, 0         # Registrador para armazenar a Soma Total (s1 = 0)

Loop_Soma:
    beq $t0, 4, Fim_Soma         # Se i == 4, sai do laco

    # [ESCREVA AQUI: Calcular o offset multiplicando 'i' por 4 novamente]
    sll $t2, $t0, 2               # Desloca 2 bits a esquerda no endereço $t2, o que equivale a multiplicar i por 4
    
    # [ESCREVA AQUI: Somar offset ao endereco base ($s0) e ler o valor do vetor (lw)]
    add $t3, $s0, $t2
    lw  $t4, 0($t3)

    # [ESCREVA AQUI: Acumular o valor lido na variavel de Soma Total ($s1)]
    add $s1, $s1, $t4
    
    addi $t0, $t0, 1             # Incrementa o contador (i++)
    j Loop_Soma                  # Volta para o inicio do laco

Fim_Soma:
    # ---------------------------------------------------------
    # IMPRESSAO DO RESULTADO
    # ---------------------------------------------------------
    
    # [ESCREVA AQUI: Imprimir a string "Soma total: "]
    li $v0, 4
    la $a0, msg_out
    syscall

    # [ESCREVA AQUI: Imprimir o numero inteiro contido em $s1]
    li $v0, 1
    move $a0, $s1
    syscall

    # Encerra o simulador
    li $v0, 10
    syscall


